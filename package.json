{
  "name": "decision-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify:source": "tsx scripts/verify-source.ts",
    "verify:details": "tsx scripts/verify-details.ts",
    "verify:catalog": "tsx scripts/verify-full-catalog.ts",
    "test:capture": "python3 -m unittest discover -s tests -p 'test_capture_rate.py'"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@xyflow/react": "^13.0.1",
    "antd": "^6.7.1",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Zeus 风格智能决策平台，本地示例数据与 SQLite 持久化"
}
